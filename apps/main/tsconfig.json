{
  "extends": "@tamery/configs/ts/react.json",
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"]
    },
    "noEmit": true,
    "strictNullChecks": true
  },
  "references": [
    {
      "path": "../api"
    }
  ],
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
